OPS_LOG_PROVIDER=cls
CLS_ENABLED=true
CLS_ENDPOINT=cls.tencentcloudapi.com
CLS_REGION=ap-guangzhou
CLS_DEFAULT_REGION=ap-guangzhou
CLS_SECRET_ID=replace-with-secret-id
CLS_SECRET_KEY=replace-with-secret-key
CLS_TOPIC_APPLICATION_LOGS=replace-with-application-log-topic-id
CLS_TOPIC_DATABASE_SLOW_QUERY=replace-with-database-slow-query-topic-id
CLS_TOPIC_SYSTEM_EVENTS=replace-with-system-event-topic-id
CLS_TOPIC_SYSTEM_METRICS=replace-with-system-metrics-topic-id
CLS_LOOKBACK_MINUTES=30
CLS_TIMEOUT_SECONDS=10
