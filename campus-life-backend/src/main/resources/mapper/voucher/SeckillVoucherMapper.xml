<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.campus.campus_life_backend.modules.voucher.mapper.SeckillVoucherMapper">

    <resultMap id="SeckillVoucherResultMap" type="com.campus.campus_life_backend.modules.voucher.entity.SeckillVoucher">
        <id property="id" column="id"/>
        <result property="voucherId" column="voucher_id"/>
        <result property="stock" column="stock"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <insert id="insertSeckillVoucher" parameterType="com.campus.campus_life_backend.modules.voucher.entity.SeckillVoucher"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `seckill_voucher` (
            voucher_id, stock, start_time, end_time, create_time
        ) VALUES (
            #{voucherId}, #{stock}, #{startTime}, #{endTime}, NOW()
        )
    </insert>

    <select id="findById" resultMap="SeckillVoucherResultMap">
        SELECT * FROM `seckill_voucher` WHERE id = #{id}
    </select>

    <select id="findByVoucherId" resultMap="SeckillVoucherResultMap">
        SELECT * FROM `seckill_voucher` WHERE voucher_id = #{voucherId}
    </select>

    <select id="findActive" resultMap="SeckillVoucherResultMap">
        SELECT * FROM `seckill_voucher`
        WHERE start_time &lt;= NOW() AND end_time &gt;= NOW()
        ORDER BY start_time DESC
    </select>

    <update id="updateSeckillVoucher" parameterType="com.campus.campus_life_backend.modules.voucher.entity.SeckillVoucher">
        UPDATE `seckill_voucher`
        SET
            stock = #{stock},
            start_time = #{startTime},
            end_time = #{endTime}
        WHERE id = #{id}
    </update>

    <update id="decrementStock">
        UPDATE `seckill_voucher`
        SET stock = GREATEST(stock - 1, 0)
        WHERE id = #{id} AND stock > 0
    </update>

    <update id="decrementStockByVoucherId">
        UPDATE `seckill_voucher`
        SET stock = stock - 1
        WHERE voucher_id = #{voucherId} AND stock > 0
    </update>

    <update id="incrementStockByVoucherId">
        UPDATE `seckill_voucher`
        SET stock = stock + 1
        WHERE voucher_id = #{voucherId}
    </update>

    <delete id="deleteByVoucherId">
        DELETE FROM `seckill_voucher`
        WHERE voucher_id = #{voucherId}
    </delete>

</mapper>
