<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.campus.campus_life_backend.modules.payment.mapper.PaymentCallbackLogMapper">

    <resultMap id="PaymentCallbackLogResultMap" type="com.campus.campus_life_backend.modules.payment.entity.PaymentCallbackLog">
        <id property="id" column="id"/>
        <result property="channel" column="channel"/>
        <result property="callbackType" column="callback_type"/>
        <result property="paymentNo" column="payment_no"/>
        <result property="bizOrderNo" column="biz_order_no"/>
        <result property="rawBody" column="raw_body"/>
        <result property="signatureVerified" column="signature_verified"/>
        <result property="amountVerified" column="amount_verified"/>
        <result property="processStatus" column="process_status"/>
        <result property="errorMessage" column="error_message"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <insert id="insert" parameterType="com.campus.campus_life_backend.modules.payment.entity.PaymentCallbackLog" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `payment_callback_log` (
            channel,
            callback_type,
            payment_no,
            biz_order_no,
            raw_body,
            signature_verified,
            amount_verified,
            process_status,
            error_message
        ) VALUES (
            #{channel},
            #{callbackType},
            #{paymentNo},
            #{bizOrderNo},
            #{rawBody},
            #{signatureVerified},
            #{amountVerified},
            #{processStatus},
            #{errorMessage}
        )
    </insert>

    <select id="findByPaymentNo" resultMap="PaymentCallbackLogResultMap">
        SELECT * FROM `payment_callback_log`
        WHERE payment_no = #{paymentNo}
        ORDER BY id DESC
    </select>

</mapper>
