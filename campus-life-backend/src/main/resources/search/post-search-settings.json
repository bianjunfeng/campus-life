{
  "analysis": {
    "tokenizer": {
      "campus_ngram_tokenizer": {
        "type": "ngram",
        "min_gram": 1,
        "max_gram": 2,
        "token_chars": [
          "letter",
          "digit"
        ]
      }
    },
    "analyzer": {
      "campus_text_analyzer": {
        "type": "custom",
        "tokenizer": "campus_ngram_tokenizer",
        "filter": [
          "lowercase"
        ]
      },
      "campus_search_analyzer": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": [
          "lowercase"
        ]
      }
    }
  }
}
