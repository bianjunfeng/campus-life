[Unit]
Description=Campus Life Backend
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=campus
WorkingDirectory=/opt/campus-life/backend
EnvironmentFile=/opt/campus-life/.env
ExecStart=/usr/bin/java -jar /opt/campus-life/backend/campus-life-backend.jar --spring.profiles.active=demo --spring.config.additional-location=file:/opt/campus-life/backend/config/
Restart=always
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
