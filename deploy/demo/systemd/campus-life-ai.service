[Unit]
Description=Campus Life AI Service
After=network.target docker.service campus-life-backend.service
Requires=docker.service

[Service]
Type=simple
User=campus
WorkingDirectory=/opt/campus-life/ai
EnvironmentFile=/opt/campus-life/.env
ExecStart=/usr/bin/java -jar /opt/campus-life/ai/campus-life-ai.jar --spring.profiles.active=demo --spring.config.additional-location=file:/opt/campus-life/ai/config/
Restart=always
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
