# Copy this file to deploy/docker/.env before running docker compose.
# Replace CHANGE_ME values before exposing the site to the public internet.

TZ=Asia/Shanghai

# Base images. Keep defaults for normal Docker Hub access.
# If Docker Hub is slow/unreachable, replace them with images from your own registry mirror.
MAVEN_IMAGE=maven:3.9-eclipse-temurin-17
JRE_IMAGE=eclipse-temurin:17-jre
NODE_IMAGE=node:20-alpine
NGINX_IMAGE=nginx:1.27-alpine
MYSQL_IMAGE=mysql:8.0
REDIS_IMAGE=redis:7-alpine
RABBITMQ_IMAGE=rabbitmq:3-management

# Public HTTP entry. Use 80 on a real server, use 8088 locally if 80 is occupied.
HTTP_PORT=80
CONSUMER_SERVER_NAME=demo.example.com
MERCHANT_SERVER_NAME=merchant.demo.example.com
ADMIN_SERVER_NAME=admin.demo.example.com
DEMO_PUBLIC_BASE_URL=https://demo.example.com

MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password
MYSQL_DATABASE=campus_life_demo
MYSQL_USER=campus_demo
MYSQL_PASSWORD=CHANGE_ME_mysql_password

# Database init: schema = empty tables only; full = tables + current snapshot data
DB_INIT_MODE=schema
AI_DB_INIT_MODE=schema

REDIS_PASSWORD=CHANGE_ME_redis_password

RABBITMQ_DEFAULT_USER=campus_mq
RABBITMQ_DEFAULT_PASS=CHANGE_ME_rabbitmq_password

JWT_SECRET=CHANGE_ME_long_random_jwt_secret_at_least_32_bytes

# Payment. Keep disabled until the sandbox keys and public callback URLs are ready.
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SKIP_NOTIFY_SIGN_VERIFY=false
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=https://demo.example.com/api/payment/alipay/notify
ALIPAY_RETURN_URL=https://demo.example.com/api/payment/alipay/return
WECHAT_ENABLED=false

# campus-life-ai
AI_MYSQL_DATABASE=campus_life_ai_demo
AI_MYSQL_USER=campus_life_ai_user
AI_MYSQL_PASSWORD=CHANGE_ME_ai_mysql_password
AI_API_KEY_ENCRYPTION_SECRET=CHANGE_ME_32_BYTE_AI_SECRET_VALUE
AI_DEFAULT_PROVIDER_CODE=openai-compatible
AI_OPENAI_COMPATIBLE_ENABLED=false
AI_OPENAI_COMPATIBLE_PROVIDER_NAME=Qwen
AI_OPENAI_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_OPENAI_COMPATIBLE_API_KEY=
AI_OPENAI_COMPATIBLE_MODEL=qwen-plus
AI_DEFAULT_MODEL_CODE=qwen-plus
AI_KNOWLEDGE_VECTOR_ENABLED=false
AI_KNOWLEDGE_VECTOR_FALLBACK_KEYWORD_SEARCH=true

# JVM options. L1 demo: keep modest for 2C4G. L2 full stack: prefer 4C8G+ and raise -Xmx if needed.
BACKEND_JAVA_OPTS=-Xms256m -Xmx768m
GATEWAY_JAVA_OPTS=-Xms128m -Xmx384m
AI_JAVA_OPTS=-Xms256m -Xmx768m

# --- L2 optional stack (COMPOSE_PROFILES=full) ---
# KAFKA_IMAGE=bitnami/kafka:3.7.1
# ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.11.0
# ES_JAVA_OPTS=-Xms512m -Xmx512m
