upstream campus_life_gateway {
    server gateway:8090;
}

server {
    listen 80;
    server_name ${CONSUMER_SERVER_NAME};
    root /usr/share/nginx/consumer-web;
    index index.html;

    client_max_body_size 20m;

    location = / {
        add_header Cache-Control "no-store";
        try_files /apps/consumer-web/index.html =404;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri /apps/consumer-web/index.html;
    }

    location /api/ {
        proxy_pass http://campus_life_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location /uploads/ {
        proxy_pass http://campus_life_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

